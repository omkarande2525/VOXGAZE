# VoxGaze Hardware & Runtime Configuration

# Camera Settings
VOXGAZE_CAMERA_INDEX=0
VOXGAZE_CAMERA_WIDTH=1280
VOXGAZE_CAMERA_HEIGHT=720
VOXGAZE_TARGET_FPS=30

# Perception & Landmark Confidence
VOXGAZE_MIN_FACE_DETECTION_CONFIDENCE=0.6
VOXGAZE_MIN_FACE_PRESENCE_CONFIDENCE=0.6
VOXGAZE_MIN_TRACKING_CONFIDENCE=0.6

# Interaction & Timing Thresholds
VOXGAZE_CONFIRM_BLINK_MIN_MS=300
VOXGAZE_CONFIRM_BLINK_MAX_MS=800
VOXGAZE_PREVIEW_TIMEOUT_MS=3000

# Safety & Abstention
VOXGAZE_ABSTENTION_ENABLED=true
VOXGAZE_TTS_ENABLED=true

# Model Assets
VOXGAZE_MODEL_PATH=models/face_landmarker.task
